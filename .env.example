# Yūgen News — web app environment (Vite).
# Copy this file to .env. Anything prefixed VITE_ is built into the PUBLIC
# JavaScript bundle: never put provider API keys here. Gemini, Groq, Anthropic,
# ElevenLabs, NewsAPI and Jina keys belong in the edge functions' secrets
# (`supabase secrets set NAME=value`). See CLAUDE.md › Security.

# Supabase (Settings -> API). The anon key is public by design; edge functions
# never accept it alone as proof of who is calling.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: skip sign-in and onboarding in local development.
VITE_DEV_MODE=

# Optional: Sentry error monitoring (path-forward §0.3). Leave unset to disable.
VITE_SENTRY_DSN=
